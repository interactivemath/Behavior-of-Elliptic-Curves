import math
from math import gcd

mod = []
primes = []
subtractions = []
solutions = []
badprimes = [2, 3, 239]

#Finding if a number is prime

def prime(x):
    if x < 2:
        return False
    elif x == 2:
        return True
    for i in range(2, math.floor(math.sqrt(x)) + 1):
        if x % i == 0:
            return False
    return True

#Running through a certain range of numbers and 
#determining if it is prime or not

for j in range(2, 1000):
    if prime(j) == True:
        primes.append(j)

#Counting the number of solutions given a certain mod of a prime number.
#Mod list is the number of solutions
def sol_counter():
    for p in primes:
        for x in range(0, p):
            for y in range(0, p):
                if (y ** 2) % p == (x ** 3 - 9 * x + 81) % p:
                    solutions.append((x, y))
        S = len(solutions)
        mod.append(S)
        solutions.clear()
    return S


sol_counter()

#Subtracting the solution number from the mod list by the prime number
def subtractor():
    for x in range(0, len(mod)):
        T = int(primes[x]) - int(mod[x])
        subtractions.append(T)


subtractor()

p_ap=zip(primes, subtractions)


dict_n_an=dict({1:1})  #a_1=1
for k,v in zip(primes, subtractions):
  dict_n_an[k]=v


for p in primes:
  for exponent in range(2, 10):
    if p in badprimes:
      dict_n_an[p**exponent] = dict_n_an[p]**exponent
    else:  #now deal with good primes
      dict_n_an[p**exponent]=dict_n_an[p**(exponent-1)]*dict_n_an[p]  
      -  p*dict_n_an[p**(exponent-2)]

for n in range(1, 1000):
    for i in range(2, n+1):
        if n % i == 0 and gcd(i, n // i) == 1:
            dict_n_an[n]= dict_n_an[i]*dict_n_an[ n // i]

for n in range(1,1000):
  print(n, dict_n_an[n])
